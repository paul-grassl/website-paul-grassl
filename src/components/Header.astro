---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import { SITE } from "@/config";
import {
  getLocaleFromPathname,
  getLocalizedPath,
  stripLocaleFromPathname,
  UI,
  type Locale,
} from "@/i18n";

export interface Props {
  locale?: Locale;
  showLanguageSwitch?: boolean;
}

const { pathname } = Astro.url;
const { locale = getLocaleFromPathname(pathname), showLanguageSwitch = true } =
  Astro.props;
const labels = UI[locale];
const targetLocale: Locale = locale === "en" ? "de" : "en";
const languageLabel = targetLocale.toUpperCase();
const languageHref = getLocalizedPath(pathname, targetLocale);
const homeHref = getLocalizedPath("/", locale);

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
const currentPathWithoutLocale = stripLocaleFromPathname(currentPath);

const isActive = (path: string) => {
  const currentPathArray = currentPathWithoutLocale
    .split("/")
    .filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return (
    currentPathWithoutLocale === path || currentPathArray[0] === pathArray[0]
  );
};
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    {labels.accessibility.skipToContent}
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-5xl flex-col items-center justify-between px-2 sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-baseline justify-between bg-background p-4 sm:items-center sm:py-6"
    >
      <a
        href={homeHref}
        class="absolute py-1 font-display text-2xl leading-8 font-normal whitespace-nowrap sm:static sm:my-auto sm:text-3xl sm:leading-none"
      >
        Paul Graßl
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 sm:hidden"
          aria-label={labels.accessibility.openMenu}
          data-open-label={labels.accessibility.openMenu}
          data-close-label={labels.accessibility.closeMenu}
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-display [&>li>a]:text-xl [&>li>a]:font-normal [&>li>a]:hover:text-accent sm:[&>li>a]:px-3 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:flex sm:w-auto sm:items-baseline sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a
              href={getLocalizedPath("/works", locale)}
              class:list={{ "active-nav": isActive("/works") }}
            >
              {labels.nav.works}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={getLocalizedPath("/exhibitions", locale)}
              class:list={{ "active-nav": isActive("/exhibitions") }}
            >
              {labels.nav.exhibitions}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={getLocalizedPath("/about", locale)}
              class:list={{ "active-nav": isActive("/about") }}
            >
              {labels.nav.about}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={getLocalizedPath("/contact", locale)}
              class:list={{ "active-nav": isActive("/contact") }}
            >
              {labels.nav.contact}
            </a>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="order-5 col-span-2 flex items-center justify-center sm:order-6 sm:col-span-1">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title={labels.accessibility.toggleTheme}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
          {
            showLanguageSwitch && (
              <li class="order-6 col-span-2 sm:order-5 sm:col-span-1">
                <a
                  id="language-switch"
                  href={languageHref}
                  lang={targetLocale}
                  hreflang={targetLocale}
                  aria-label={labels.accessibility.switchLanguage}
                  class="!text-base"
                >
                  {languageLabel}
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.getAttribute("data-open-label") || "Open menu";
    const closeLabel = menuBtn.getAttribute("data-close-label") || "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
