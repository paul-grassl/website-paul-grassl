---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconMail from "@/assets/icons/IconMail.svg";
import IconInstagram from "@/assets/icons/IconInstagram.svg";
import { UI, type Locale } from "@/i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = UI[locale];
---

<Layout
  title={labels.pages.contact}
  description={labels.meta.contact}
  locale={locale}
>
  <Header locale={locale} />
  <main id="main-content">
    <section class="mx-auto w-full max-w-2xl px-3 py-16 md:px-8 lg:px-24">
      <div class="space-y-6 text-center">
        <div class="space-y-4">
          <a
            href="mailto:paulgrassl.studio@gmail.com"
            class="group flex items-center justify-center gap-2 text-lg text-accent transition-colors hover:text-accent/80"
          >
            <IconMail
              class="size-6 transition-transform group-hover:-translate-y-1 group-hover:scale-110"
            />
            paulgrassl.studio@gmail.com
          </a>
          <a
            href="https://instagram.com/paul.grassl"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-center gap-2 text-lg text-accent transition-colors hover:text-accent/80"
          >
            <IconInstagram
              class="size-6 transition-transform group-hover:-translate-y-1 group-hover:scale-110"
            />
            @paul.grassl
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
