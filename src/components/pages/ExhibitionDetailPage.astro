---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import OptimizedImage from "@/components/OptimizedImage.astro";
import type { CollectionEntry } from "astro:content";
import { UI, type Locale } from "@/i18n";

export interface Props {
  locale: Locale;
  exhibition: CollectionEntry<"exhibitions">;
}

const { locale, exhibition } = Astro.props;
const labels = UI[locale];
const { title, images = [], image, exhibitionViews = "XX" } = exhibition.data;
const localizedData =
  locale === "de"
    ? { ...exhibition.data, ...exhibition.data.de }
    : exhibition.data;
const displayImages =
  images.length > 0
    ? images
    : [{ src: image, orientation: "landscape" as const }];
const localizedExhibitionViews =
  locale === "de" ? exhibition.data.de.exhibitionViews : exhibitionViews;
---

<Layout
  title={title}
  description={`${labels.meta.exhibitionPrefix}: ${title}`}
  locale={locale}
>
  <Header locale={locale} />
  <main id="main-content">
    <section class="mx-auto w-full max-w-5xl px-6 py-8">
      <div class="flex flex-col gap-y-8">
        <div class="w-full">
          <h1
            class="mb-2 text-2xl leading-tight font-normal text-foreground italic"
          >
            {title}
          </h1>
          <div
            class="text-muted-foreground mt-0.5 flex flex-col text-base leading-tight"
          >
            <span>{localizedData.location}</span>
            <span>{localizedData.type}</span>
            <span>{localizedData.period}</span>
          </div>
        </div>

        {
          displayImages.map((displayImage, index) => {
            const isPortrait = displayImage.orientation === "portrait";

            return (
              <div class="w-full">
                <div
                  class={
                    isPortrait
                      ? "mx-auto aspect-[2/3] max-w-md overflow-hidden bg-muted"
                      : "aspect-[3/2] w-full overflow-hidden bg-muted"
                  }
                >
                  <OptimizedImage
                    src={displayImage.src}
                    alt={`${title}, ${labels.accessibility.exhibitionView} ${index + 1}`}
                    width={isPortrait ? 448 : 976}
                    widths={
                      isPortrait
                        ? [320, 448, 640, 896]
                        : [480, 768, 1024, 1536, 2048]
                    }
                    sizes={
                      isPortrait
                        ? "(max-width: 496px) calc(100vw - 3rem), 448px"
                        : "(max-width: 1024px) calc(100vw - 3rem), 976px"
                    }
                    priority={index === 0}
                    fit="cover"
                  />
                </div>
              </div>
            );
          })
        }

        <div class="w-full">
          <div class="text-muted-foreground text-base">
            <span>
              {labels.exhibitionViews}: {localizedExhibitionViews}
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
