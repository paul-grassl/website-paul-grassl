---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import OptimizedImage from "@/components/OptimizedImage.astro";
import { getCollection } from "astro:content";
import { getLocalizedPath, UI, type Locale } from "@/i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = UI[locale];

const currentData = await getCollection("current");
const landingImage = currentData.find(entry =>
  entry.id.includes("landing-image")
);

const currentExhibitions = currentData
  .filter(entry => !entry.id.includes("landing-image"))
  .filter(entry => entry.data.title && entry.data.title.trim() !== "")
  .sort((a, b) => a.id.localeCompare(b.id));

const hasCurrentExhibitions = currentExhibitions.length > 0;
const landingData = landingImage
  ? locale === "de"
    ? { ...landingImage.data, ...landingImage.data.de }
    : landingImage.data
  : undefined;
---

<Layout title="Paul Graßl" description={labels.meta.home} locale={locale}>
  <Header locale={locale} />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={getLocalizedPath("/", locale)}
  >
    <section class="mx-auto w-full max-w-5xl px-6 py-8">
      <div class="flex flex-col gap-y-8">
        {
          hasCurrentExhibitions && (
            <div class="w-full">
              <h1 class="mb-2 text-2xl leading-tight font-normal text-foreground">
                {labels.pages.currentCalendar}
              </h1>
              <div class="mt-4 space-y-6">
                {currentExhibitions.map(exhibition => {
                  const data =
                    locale === "de"
                      ? { ...exhibition.data, ...exhibition.data.de }
                      : exhibition.data;

                  return (
                    <div class="exhibition-entry">
                      <h2 class="mb-1 text-xl font-normal text-foreground italic">
                        {data.title}
                      </h2>
                      <div class="text-muted-foreground flex flex-col gap-y-0.5 text-lg">
                        {data.locationUrl && data.locationUrl.trim() !== "" ? (
                          <a
                            href={data.locationUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="underline decoration-1 underline-offset-2 transition-colors hover:text-foreground"
                          >
                            {data.location}
                          </a>
                        ) : (
                          <span>{data.location}</span>
                        )}
                        {data.type && <span>{data.type}</span>}
                        {data.opening && <span>{data.opening}</span>}
                        {data.additionalInfo && (
                          <span>{data.additionalInfo}</span>
                        )}
                        {data.period && <span>{data.period}</span>}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )
        }

        {
          landingImage && landingData?.image && (
            <div class="w-full">
              <div class="flex justify-center">
                <div class="w-full max-w-2xl">
                  <OptimizedImage
                    src={landingData.image}
                    alt={landingData.alt || labels.accessibility.currentArtwork}
                    width={672}
                    widths={[320, 672, 960, 1344]}
                    sizes="(max-width: 720px) calc(100vw - 3rem), 672px"
                    priority={!hasCurrentExhibitions}
                  />
                  {landingData.caption && landingData.caption.trim() !== "" && (
                    <div class="mt-2 text-center">
                      <p class="text-muted-foreground text-base italic">
                        {landingData.caption}
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector<HTMLElement>(
      '#main-content[data-layout="index"]'
    );
    const homePath = indexLayout?.dataset.homePath;

    if (homePath) sessionStorage.setItem("backUrl", homePath);
  });
</script>
