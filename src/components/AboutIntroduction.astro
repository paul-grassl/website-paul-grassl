---
import { SITE } from "@/config";
import type { Locale } from "@/i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

{
  locale === "en" && (
    <div class="about-introduction">
      <p class="about-meta">*1993, based in Munich, Germany</p>
      {SITE.showArtistStatement && (
        <div class="artist-statement">
          <p>
            <em>
              In my work, I seek out places where something of the present is
              emerging or where shifts have taken on a visible form.
            </em>
          </p>
          <p>
            <em>
              My practice often begins with field research: I travel to these
              places, sketch them and take photographs. With a background in
              behavioural sciences, it comes naturally to me to observe and
              engage with a subject before it finds its way into the image.
            </em>
          </p>
          <p>
            <em>
              I am particularly interested in motifs that serve as signs
              pointing towards a development. How these places affect me and
              what they trigger within me—be it a sense of familiarity or
              unease—flows into my representation.
            </em>
          </p>
          <p>
            <em>
              I attempt to trace these sensations in painting, drawing and
              printmaking and to give them form.
            </em>
          </p>
        </div>
      )}
    </div>
  )
}

{
  locale === "de" && (
    <div class="about-introduction">
      <p class="about-meta">*1993, lebt und arbeitet in München</p>
      {SITE.showArtistStatement && (
        <div class="artist-statement">
          <p>
            <em>
              In meinen Arbeiten suche ich Orte auf, an denen sich etwas
              Gegenwärtiges abzeichnet oder an denen Verschiebungen eine
              sichtbare Form angenommen haben.
            </em>
          </p>
          <p>
            <em>
              Meine Praxis beginnt oft mit Feldforschung: Ich fahre zu den
              Orten, zeichne und fotografiere sie. Mit einem Hintergrund in den
              Verhaltenswissenschaften liegt es mir nahe, ein Thema zu
              beobachten und mich damit auseinanderzusetzen, bevor es ins Bild
              findet.
            </em>
          </p>
          <p>
            <em>
              Dabei interessieren mich besonders Motive, die als Zeichen auf
              eine Entwicklung hinweisen. Wie diese Orte auf mich wirken und was
              sie in mir auslösen, sei es Vertrautheit oder Unbehagen, fließt in
              meine Darstellung mit ein.
            </em>
          </p>
          <p>
            <em>
              Diesen Empfindungen versuche ich in Malerei, Zeichnung und
              Druckgrafik nachzuspüren und ihnen eine Form zu geben.
            </em>
          </p>
        </div>
      )}
    </div>
  )
}
