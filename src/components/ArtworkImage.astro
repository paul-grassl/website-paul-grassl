---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  orientation: "landscape" | "portrait";
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  orientation,
  priority = false,
  class: className,
} = Astro.props;

const isPortrait = orientation === "portrait";
const width = isPortrait ? 576 : 896;
const widths = isPortrait ? [320, 576, 768, 1152] : [480, 896, 1280, 1792];
const sizes = isPortrait
  ? "(max-width: 624px) calc(100vw - 3rem), 576px"
  : "(max-width: 944px) calc(100vw - 3rem), 896px";
---

<Image
  src={src}
  alt={alt}
  width={width}
  widths={widths}
  sizes={sizes}
  quality={80}
  format="webp"
  priority={priority}
  class:list={["artwork-image", className]}
  data-artwork-image
/>

<style>
  .artwork-image {
    display: block;
    width: 100%;
    height: auto;
    background-color: var(--muted);
  }
</style>
